# Copy the relevant values into the real (gitignored) env files, then fill them in.
# This file is committed as documentation — keep placeholder values only, never real secrets.

# ── .env  (read by Prisma CLI + the app) ──────────────────────────────
# Local SQLite file used by Prisma. Recreate the DB with `npx prisma migrate dev`.
DATABASE_URL="file:./dev.db"

# ── .env.local  (app secrets) ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=auth_secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth 2.0 Web client — https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#   Authorized JS origin:     http://localhost:3000
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret

# ── OpenTelemetry (optional, local dev) ───────────────────────────────
# Telemetry is OPT-IN: the OTel SDK starts only when an OTLP endpoint is set.
# Leave these unset for local dev and the app runs untouched (pino still logs
# JSON to stdout, just without trace IDs).
#
# Start the local collector + Jaeger:  docker compose -f deploy/local/docker-compose.yaml up -d
# Then uncomment to export traces/logs (Jaeger UI: http://localhost:16686):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=content-generator
# OTEL_SERVICE_VERSION=0.1.0
#
# Optional collector headers (e.g. auth), comma-separated key=value pairs:
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>
#
# pino log level: trace | debug | info | warn | error | fatal (default: info)
# LOG_LEVEL=info
