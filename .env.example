# Copy the relevant values into the real (gitignored) env files, then fill them in.
# This file is committed as documentation — keep placeholder values only, never real secrets.

# ── .env  (read by drizzle-kit + the app) ──────────────────────────────
# Local Postgres used by Drizzle. Start it with:
#   docker compose -f deploy/local/docker-compose.yaml up -d postgres
# Then apply migrations with `npx drizzle-kit migrate` and seed with
# `npm run db:seed`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"

# In a deployed Worker, Postgres access goes through the "HYPERDRIVE" binding
# (see wrangler.app.jsonc), not DATABASE_URL. For local dev (`next dev` /
# `npm run app:preview`), Wrangler reads this exact env var name to override
# that binding's connection string with a direct local connection — same
# value as DATABASE_URL above, no real Cloudflare Hyperdrive resource needed:
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE="postgresql://postgres:postgres@localhost:5432/app"

# ── .env.local  (app secrets) ─────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=auth_secret
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth 2.0 Web client — https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#   Authorized JS origin:     http://localhost:3000
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret

# ── Logging ────────────────────────────────────────────────────────────
# App logger (src/lib/logger.ts) level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# ── Cloudflare Queues (async job processing) ──────────────────────────
# Required for the "Async Job" demo card (submitHelloJob / src/lib/queue.ts)
# to enqueue jobs — without one of the two setups below, that server action
# throws immediately.
#
# OPTION A — local simulation, no Cloudflare account needed (recommended for
# local dev): leave CLOUDFLARE_* below unset, and instead set this to point
# at `wrangler dev`'s default local address:
QUEUE_LOCAL_PUSH_URL=http://localhost:8787
# Then run `npm run worker:dev` (wrangler dev) in a second terminal — it
# simulates the "hello"/"hello-dlq" queues entirely locally via Miniflare and
# exposes a local-only HTTP endpoint (gated by .dev.vars — copy
# .dev.vars.example to .dev.vars first) that stands in for Cloudflare's real
# push API. See deploy/README.md.
#
# OPTION B — real Cloudflare account (required for production; also usable
# locally if you want to exercise the real API path): leave
# QUEUE_LOCAL_PUSH_URL unset and fill these in instead.
#
# Your Cloudflare account id (dashboard overview page, right sidebar):
# CLOUDFLARE_ACCOUNT_ID=
# An API token with "Queues Edit" permission:
#   https://dash.cloudflare.com/profile/api-tokens
# CLOUDFLARE_API_TOKEN=
# The "hello" queue's ID (a UUID, NOT its name). One-time setup:
#   npx wrangler login
#   npx wrangler queues create hello
#   npx wrangler queues create hello-dlq
#   npx wrangler queues list        # copy the "hello" queue's id from here
# CLOUDFLARE_HELLO_QUEUE_ID=
