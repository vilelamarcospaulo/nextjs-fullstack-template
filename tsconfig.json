{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // drizzle/seed.ts imports src/lib/schema.ts with an explicit `.ts`
    // extension because it runs at runtime via `node drizzle/seed.ts` (Node TS
    // stripping doesn't resolve extensionless relative TS imports). Allowed
    // here because `noEmit` is set.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    // "@cloudflare/vitest-pool-workers/types" adds the ambient
    // `declare module "cloudflare:test"` typings (createMessageBatch,
    // getQueueResult, etc.) used by src/worker/index.test.ts — needed
    // because this repo has one tsconfig.json for the whole program, and
    // the "cloudflare:test" virtual module specifier is only resolvable at
    // the type level via this "types" array entry (it isn't reachable
    // through any import graph the way a normal .d.ts is).
    "types": ["vitest/globals", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
