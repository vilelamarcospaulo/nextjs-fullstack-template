# Docker Compose environment example for content-generator
# Copy this to .env.docker and fill in actual values — do NOT commit secrets.

# ── Database ──────────────────────────────────────────────────────────
# SQLite database file path inside the container. Must be on the shared
# appdata volume (/data) so both migrate and app services share one DB.
# This is injected by docker-compose.yml for the running app.
DATABASE_URL=file:/data/app.db

# ── Authentication & OAuth ────────────────────────────────────────────
# Generate BETTER_AUTH_SECRET: openssl rand -base64 32
BETTER_AUTH_SECRET=your_secret_key_here

# Base URL for the app (used in auth callbacks and links).
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth 2.0 Web client credentials from https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Authorized JS origin:     http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ── OpenTelemetry (injected by docker-compose.yml) ───────────────────
# Telemetry is OPT-IN: the app only exports traces + logs when an OTLP
# endpoint is configured. The compose file sets:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
#   OTEL_SERVICE_NAME=content-generator
#   OTEL_SERVICE_VERSION=0.1.0
#   LOG_LEVEL=info
# These values are NOT here because compose injects them automatically.
