# =============================================================================
# deploy/production/.env.example
#
# Copy this file to .env and fill in all values before running the stack.
# The real .env is gitignored — never commit it.
#
# OTEL_* variables are injected by docker-compose.yaml and do NOT need to
# be set here; they are hard-coded to the internal service endpoints.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB configure the `postgres`
# service itself (its official image reads these on first boot to create the
# role and database). DATABASE_URL must reference the SAME three values and
# the `postgres` service name (not localhost) — the app and migrate services
# reach Postgres over the internal appnet network using that hostname.
# Pick your own POSTGRES_PASSWORD; the example below is a placeholder only.
# -----------------------------------------------------------------------------
POSTGRES_USER=appuser
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=app
DATABASE_URL=postgresql://appuser:CHANGE_ME@postgres:5432/app

# -----------------------------------------------------------------------------
# Better Auth
# BETTER_AUTH_SECRET: random 32-byte base64 string.
#   Generate with: openssl rand -base64 32
# BETTER_AUTH_URL: must exactly match the public HTTPS URL of the app.
#   The Google OAuth redirect URI must be:
#     https://your-domain.example.com/api/auth/callback/google
#   Register that URI in your Google Cloud Console → Credentials → OAuth client.
# Note: docker-compose.yaml sets BETTER_AUTH_URL=https://${DOMAIN} at runtime;
# the value here is used only if that compose override is somehow absent.
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://your-domain.example.com

# -----------------------------------------------------------------------------
# Google OAuth
# Create credentials at https://console.cloud.google.com/apis/credentials
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Deployment domain
# DOMAIN: the public hostname of your VPS (no scheme, no trailing slash).
#   Example: app.example.com
#   DNS: an A record must point this hostname at the VPS IP before running
#   init-letsencrypt.sh, otherwise the ACME http-01 challenge will fail.
# Used by: nginx envsubst (app.conf.template), certbot, BETTER_AUTH_URL override.
# -----------------------------------------------------------------------------
DOMAIN=your-domain.example.com

# -----------------------------------------------------------------------------
# Let's Encrypt
# Email address for certificate expiry notices from Let's Encrypt.
# -----------------------------------------------------------------------------
LETSENCRYPT_EMAIL=you@example.com

# -----------------------------------------------------------------------------
# Worker
# WORKER_CONCURRENCY: optional. Max number of jobs the `worker` service's
# pg-boss consumer processes concurrently. Defaults to 5 (set in
# docker-compose.yaml) if left commented out / unset.
# -----------------------------------------------------------------------------
# WORKER_CONCURRENCY=5
