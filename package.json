{
  "name": "starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:ui": "vitest run --project ui",
    "test:worker": "vitest run --project worker",
    "test:app-worker": "vitest run --project app-worker",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "queue-worker:dev": "wrangler dev",
    "queue-worker:deploy": "wrangler deploy",
    "app:build": "opennextjs-cloudflare build",
    "app:preview": "opennextjs-cloudflare preview --config wrangler.app.jsonc",
    "app:deploy": "opennextjs-cloudflare deploy --config wrangler.app.jsonc",
    "db:seed": "node drizzle/seed.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview --config wrangler.app.jsonc",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --config wrangler.app.jsonc",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload --config wrangler.app.jsonc",
    "cf-typegen": "wrangler types --config wrangler.app.jsonc --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.6.19",
    "class-variance-authority": "^0.7.1",
    "cloudflare": "^7.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260717.1",
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "^4.112.0"
  }
}
