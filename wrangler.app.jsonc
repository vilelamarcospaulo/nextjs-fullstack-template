{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "starter-kit-app",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Postgres access via Hyperdrive (see src/lib/db.ts) — the decided approach
  // for this migration, not D1 or a PostgreSQL proxy. localConnectionString
  // below is the same non-secret local Postgres default used throughout this
  // repo (.env.example, docker-compose) — not a real credential, safe to
  // check in — so `wrangler dev`/`opennextjs-cloudflare preview`/the
  // "app-worker" Vitest project all work with zero extra setup. Wrangler
  // reads this at pool-startup time, before Miniflare boots, so it must come
  // from here or a real (not .dev.vars-merged) process env var — override it
  // per-environment via CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE
  // (see .env.example) if your local Postgres uses a different URL.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "755d3e89a9cf4d6792580d642d91a0c6",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/app",
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // Producer binding for the "hello" queue (src/lib/queue.ts's sendJob reads
  // it via getCloudflareContext().env.HELLO_QUEUE, same pattern as the
  // HYPERDRIVE binding above) — pushes messages through Cloudflare's
  // internal Worker-to-Queue path, no account id/API token/queue id needed.
  // The queue itself is provisioned once via `wrangler queues create hello`.
  "queues": {
    "producers": [
      {
        "queue": "hello",
        "binding": "HELLO_QUEUE",
      },
    ],
  },
  // QUEUE_LOCAL_PUSH_URL is pinned to "" deliberately: @opennextjs/cloudflare
  // bakes whatever .env/.env.local values were present at `app:build` time
  // into .open-next/cloudflare/next-env.mjs as a production fallback, and
  // that fallback is only skipped for vars that have a real platform
  // binding (see populateProcessEnv in
  // node_modules/@opennextjs/cloudflare/dist/cli/templates/init.js). Without
  // this, building app:build from a checkout whose .env.local still has the
  // local-dev QUEUE_LOCAL_PUSH_URL=http://localhost:8787 override (see
  // .env.example) ships that value to production, where sendJob's fetch to
  // localhost gets blocked by the global_fetch_strictly_public flag above
  // and returns a Cloudflare 403 (error 1003) instead of using the
  // HELLO_QUEUE binding above.
  "vars": {
    "QUEUE_LOCAL_PUSH_URL": "",
  },
  "services": [
    {
      // Self-reference service binding, the service name must match the worker name
      // see https://opennext.js.org/cloudflare/caching
      "binding": "WORKER_SELF_REFERENCE",
      "service": "starter-kit-app",
    },
  ],
  "images": {
    // Enable image optimization
    // see https://opennext.js.org/cloudflare/howtos/image
    "binding": "IMAGES",
  },
  // Workers Logs storage/querying in the dashboard — off by default for a
  // freshly created Worker, otherwise requires a manual per-Worker dashboard
  // toggle each time. `wrangler tail` works regardless of this setting.
  "observability": {
    "enabled": true,
  },
}
