# Dependencies — reinstalled inside the image
node_modules

# Next.js build output — produced inside the image
.next

# Version control
.git
.gitignore

# Test artefacts
coverage
test-results
*.snap

# Environment / secrets — never bake into the image
.env
.env.*
!.env.example

# Docker files themselves (no need to COPY into the image)
Dockerfile
docker-compose.yml
docker-compose.*.yml

# CI / tooling config
.github
.claude

# TypeScript incremental build info
*.tsbuildinfo

# Editor / OS noise
.DS_Store
*.swp
*.swo
.idea
.vscode

# Docs
README.md
AGENTS.md
CLAUDE.md
